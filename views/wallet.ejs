<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="/theme.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <% if (paypalClientId) { %>
  <script src="https://www.paypal.com/sdk/js?client-id=<%= paypalClientId %>&currency=SGD&intent=capture"></script>
  <% } %>
  <title>Wallet</title>
  <style>
    body { background:#111213; color:#fff; font-family:'Montserrat',system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; background-image:url('/images/bg.png'); background-size:cover; background-repeat:no-repeat; background-attachment:fixed; }
    body::before { content:''; position:fixed; inset:0; background:rgba(0,0,0,0.45); z-index:-1; }
    .custom-navbar { background-color:transparent !important; padding-top:1.05rem; padding-bottom:1.05rem; min-height:80px; z-index:1030; box-shadow:none; }
    .custom-navbar .navbar-brand { font-weight:700; letter-spacing:-0.01em; }
    .brand-logo { font-family:'Montserrat',system-ui,sans-serif; display:inline-flex; flex-direction:column; text-align:center; text-decoration:none; line-height:1.05; padding-left:0.1rem; }
    .brand-main { font-size:1.45rem; font-weight:700; letter-spacing:0.33em; text-transform:uppercase; color:#ffffff; }
    .brand-sub { font-size:0.68rem; font-weight:500; letter-spacing:0.28em; text-transform:uppercase; color:rgba(255,255,255,0.75); margin-top:0.15rem; }
    .card-frosted { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); border-radius: 1rem; -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); box-shadow: 0 18px 48px rgba(0,0,0,0.55); padding: 1.25rem; }
    footer.site-footer { background:#0b0c0d; color:#fff; padding:2.5rem 0; border-top:1px solid rgba(255,255,255,0.03); }
    .wallet-balance { font-size:2rem; font-weight:700; }
    .input-ghost { background: rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); color:#fff; }
    .input-ghost:focus { background: rgba(255,255,255,0.08); color:#fff; border-color: rgba(255,255,255,0.32); box-shadow: 0 0 0 0.2rem rgba(255,255,255,0.12); }
  </style>
</head>
<body class="theme-gradient d-flex flex-column min-vh-100">
  <nav class="navbar navbar-expand-sm navbar-dark bg-dark custom-navbar">
    <div class="container-fluid">
      <a class="navbar-brand brand-logo" href="/">
        <span class="brand-main">SUPERMARKET</span>
        <span class="brand-sub">SINGAPORE</span>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar"><span class="navbar-toggler-icon"></span></button>
      <div class="collapse navbar-collapse" id="collapsibleNavbar">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item d-flex align-items-center me-3"><span class="text-light small">Signed in as <strong><%= user.username %></strong></span></li>
          <li class="nav-item ms-2"><a class="btn btn-outline-light btn-sm btn-cta btn-minimal" href="/wallet">Wallet</a></li>
          <li class="nav-item ms-2"><a class="btn btn-outline-light btn-sm btn-cta btn-minimal" href="/checkout">Checkout</a></li>
          <li class="nav-item ms-2"><a class="btn btn-outline-light btn-sm btn-cta btn-minimal" href="/logout">Logout</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <main class="container flex-grow-1 py-4">
    <div class="row g-3">
      <div class="col-lg-6">
        <div class="card-frosted h-100">
          <h4 class="fw-bold mb-2">Wallet Balance</h4>
          <% if (success && success.length) { %>
            <div class="alert alert-success py-2"><%= success[0] %></div>
          <% } %>
          <% if (error && error.length) { %>
            <div class="alert alert-danger py-2"><%= error[0] %></div>
          <% } %>
          <div class="wallet-balance">$<%= Number(walletBalance || 0).toFixed(2) %></div>
          <small class="text-white-50">Use your wallet balance to pay instantly at checkout.</small>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="card-frosted">
          <h4 class="fw-bold mb-3">Top Up with PayPal (Sandbox)</h4>
          <label class="form-label">Top-up amount (SGD)</label>
          <input type="number" step="0.01" min="1" max="2000" class="form-control input-ghost mb-3" id="topupAmount" placeholder="e.g. 25.00" value="25.00">
          <div id="paypal-topup-container"></div>
          <div id="topupStatus" class="text-white-50 small mt-2"></div>
          <small class="text-white-50 d-block mt-3">Payments are processed in PayPal sandbox mode.</small>
        </div>
      </div>
    </div>
  </main>

  <footer class="site-footer mt-auto">
    <div class="container text-center">
      <p class="mb-1">Supermarket Singapore elevates everyday shopping with curated essentials, premium quality, and a refined digital experience. Seamless, stylish, and sophisticated — where everyday living meets modern luxury.</p>
      <small class="small">© <%= new Date().getFullYear() %> — by Saw Kaung Khant Thiha.</small>
    </div>
  </footer>

  <script>
    const topupAmountInput = document.getElementById('topupAmount');
    const topupStatus = document.getElementById('topupStatus');

    const getTopupAmount = () => {
      const value = Number(topupAmountInput.value || 0);
      return Number.isNaN(value) ? 0 : Number(value.toFixed(2));
    };

    if (window.paypal && document.getElementById('paypal-topup-container')) {
      paypal.Buttons({
        createOrder: async () => {
          const amount = getTopupAmount();
          if (!amount || amount <= 0) {
            throw new Error('Enter a valid top-up amount.');
          }
          topupStatus.textContent = 'Creating PayPal top-up...';
          const createRes = await fetch('/api/wallet/topup/create-order', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ amount })
          });
          const createData = await createRes.json();
          if (!createRes.ok) throw new Error(createData.error || 'Unable to create PayPal order');
          return createData.id;
        },
        onApprove: async (data) => {
          topupStatus.textContent = 'Capturing PayPal top-up...';
          const captureRes = await fetch('/api/wallet/topup/capture', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ orderID: data.orderID })
          });
          const captureData = await captureRes.json();
          if (!captureRes.ok) throw new Error(captureData.error || 'Unable to capture PayPal order');
          topupStatus.textContent = 'Wallet credited. Refreshing...';
          window.location.reload();
        },
        onError: (err) => {
          topupStatus.textContent = err.message || 'PayPal error occurred.';
        }
      }).render('#paypal-topup-container');
    } else if (topupStatus) {
      topupStatus.textContent = 'PayPal SDK not loaded. Check your client ID.';
    }
  </script>
</body>
</html>
