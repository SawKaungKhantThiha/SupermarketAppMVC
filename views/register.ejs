<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Google Font: Montserrat (Gotham-like) -->
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="/theme.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <title>Supermarket App - Register</title>
  <style>
    body {
      background-image: url('/images/bg.png');
      background-size: cover;
      background-position: center center;
      background-repeat: no-repeat;
      background-attachment: fixed;
      background-color: #111213;
      color: #fff;
      font-family: 'Montserrat', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      -webkit-font-smoothing:antialiased;
      -moz-osx-font-smoothing:grayscale;
    }
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.45);
      pointer-events: none;
      z-index: 0;
    }
    .custom-navbar { background-color: transparent !important; padding-top:1.05rem; padding-bottom:1.05rem; min-height:80px; z-index:1030; }
    .auth-card { margin: 3rem auto; max-width: 600px; background: rgba(255,255,255,0.04); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); border-radius:0.8rem; padding:1.25rem 1.5rem; box-shadow: 0 12px 40px rgba(0,0,0,0.5); }
    .form-control { background: rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06); color:#fff; }
    .form-control:focus { box-shadow:0 0 0 0.12rem rgba(255,255,255,0.06); }
    .btn-cta { padding: 0.36rem 0.8rem; }
    footer.site-footer { background:#0b0c0d; color:#fff; padding:2.5rem 0; border-top:1px solid rgba(255,255,255,0.03); }
    a, .nav-link { color: rgba(255,255,255,0.95); }
    .brand-logo {
      font-family: 'Montserrat', system-ui, sans-serif;
      display: inline-flex;
      flex-direction: column;
      text-align: center;
      text-decoration: none;
      line-height: 1.05;
      padding-left: 0.1rem;
    }

    .brand-main {
      font-size: 1.45rem;
      font-weight: 700;
      letter-spacing: 0.33em;
      text-transform: uppercase;
      color: #ffffff;
    }

    .brand-sub {
      font-size: 0.68rem;
      font-weight: 500;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.75);
      margin-top: 0.15rem;
    }
    .auth-card h2 { margin-bottom: 0.5rem; font-weight:700; }
  </style>
</head>
<body class="theme-gradient d-flex flex-column min-vh-100">
  <a class="visually-hidden-focusable" href="#main-content">Skip to main content</a>
  <nav class="navbar navbar-expand-sm navbar-dark bg-dark custom-navbar">
    <div class="container-fluid" role="navigation" aria-label="Main navigation">
      <a class="navbar-brand brand-logo" href="/">
        <span class="brand-main">SUPERMARKET</span>
        <span class="brand-sub">SINGAPORE</span>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar" aria-controls="collapsibleNavbar" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
    </div>
  </nav>

  <main id="main-content" class="container flex-grow-1" role="main">
    <div class="auth-card">
      <h2 class="text-center">Create an account</h2>
      <p class="text-center" style="color:rgba(255,255,255,0.75)">Fill in your details to register</p>

      <% if (messages && messages.length > 0) { %>
        <div class="alert alert-danger">
          <% messages.forEach(function(message) { %>
            <div><%= message %></div>
          <% }); %>
        </div>
      <% } %>

      <form action="/register" method="POST" class="mt-3" id="registerForm">
        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="username" class="form-label">Username</label>
            <input type="text" id="username" name="username" class="form-control" required value="<%= formData && formData.username ? formData.username : '' %>">
          </div>
          <div class="col-md-6 mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" id="email" name="email" class="form-control" required value="<%= formData && formData.email ? formData.email : '' %>">
          </div>
        </div>

        <div class="mb-3">
          <label for="password" class="form-label">Password</label>
          <input type="password" id="password" name="password" class="form-control" required>
        </div>

        <div class="row">
          <div class="col-md-8 mb-3">
            <label for="address" class="form-label">Address</label>
            <input type="text" id="address" name="address" class="form-control" required value="<%= formData && formData.address ? formData.address : '' %>">
          </div>
          <div class="col-md-4 mb-3">
            <label for="contact" class="form-label">Contact</label>
            <input type="text" id="contact" name="contact" class="form-control" required value="<%= formData && formData.contact ? formData.contact : '' %>">
          </div>
        </div>

        <input type="hidden" name="termsAccepted" id="termsAccepted" value="no">
        <div class="d-flex justify-content-between align-items-center">
          <a href="/login" style="color:rgba(255,255,255,0.8); text-decoration: none;">Already have an account?</a>
          <button type="submit" class="btn btn-outline-light btn-cta">Register</button>
        </div>
      </form>
    </div>
  </main>  <footer class="site-footer mt-auto">
  <div class="container text-center">
    <p class="mb-1">Supermarket Singapore elevates everyday shopping with curated essentials, premium quality, and a refined digital experience. Seamless, stylish, and sophisticated — where everyday living meets modern luxury.</p>
    <small class="small">© <%= new Date().getFullYear() %> — by Saw Kaung Khant Thiha.</small>
  </div>
</footer>
  <style>
    .terms-modal .modal-content {
      background: rgba(12,13,14,0.96);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 1rem;
      box-shadow: 0 24px 60px rgba(0,0,0,0.55);
    }
    .terms-modal .modal-header,
    .terms-modal .modal-footer {
      border-color: rgba(255,255,255,0.08);
    }
    .terms-modal .section-title {
      text-transform: uppercase;
      letter-spacing: 0.14em;
      font-size: 0.7rem;
      font-weight: 700;
      color: rgba(255,255,255,0.65);
      margin-bottom: 0.25rem;
    }
    .terms-modal .section-text {
      color: rgba(255,255,255,0.72);
      font-size: 0.9rem;
      line-height: 1.5;
    }
    .terms-modal .divider {
      height: 1px;
      background: rgba(255,255,255,0.06);
      margin: 0.9rem 0;
    }
    .terms-modal .form-check-input {
      background-color: rgba(255,255,255,0.06);
      border-color: rgba(255,255,255,0.25);
    }
    .terms-modal .form-check-input:checked {
      background-color: #ffffff;
      border-color: #ffffff;
    }
    .terms-modal .form-check-label {
      color: rgba(255,255,255,0.85);
    }
    .terms-modal .btn-ghost {
      border: 1px solid rgba(255,255,255,0.2);
      color: #fff;
      background: transparent;
    }
    .terms-modal .btn-ghost:hover {
      background: rgba(255,255,255,0.06);
    }
    .terms-modal .btn-cta-solid {
      background: #ffffff;
      color: #000;
      border: 1px solid rgba(255,255,255,0.12);
      font-weight: 700;
      letter-spacing: 0.02em;
    }
    .terms-modal .btn-cta-solid:disabled {
      opacity: 0.5;
    }
  </style>
  <div class="modal fade terms-modal" id="termsModal" tabindex="-1" aria-labelledby="termsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content text-white">
        <div class="modal-header">
          <div>
            <div class="section-title">Supermarket Singapore</div>
            <h5 class="modal-title mb-0" id="termsModalLabel">Terms & Conditions</h5>
          </div>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="section-title">Account Registration</div>
          <p class="section-text">By registering, you confirm that all information provided is accurate and complete. You are responsible for safeguarding your account credentials and for all activity that occurs under your account.</p>
          <div class="divider"></div>
          <div class="section-title">Orders & Payments</div>
          <p class="section-text">All orders are subject to acceptance and product availability. Prices, promotions, and availability may be updated at any time without prior notice. Payment authorization is required to complete an order.</p>
          <div class="divider"></div>
          <div class="section-title">Delivery, Cancellations & Refunds</div>
          <p class="section-text">Delivery timeframes are estimates only and are not guaranteed. Cancellations, returns, and refunds are governed by our published policies and eligibility criteria.</p>
          <div class="divider"></div>
          <div class="section-title">Privacy & Data Use</div>
          <p class="section-text">We collect and use personal information to manage your account, process orders, deliver goods, and provide customer support, in accordance with our Privacy Policy and applicable law.</p>
          <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" id="agreeTerms">
            <label class="form-check-label" for="agreeTerms">I have read and agree to the Terms & Conditions and Privacy Policy.</label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-cta-solid" id="agreeContinueBtn" disabled>Agree & Continue</button>
        </div>
      </div>
    </div>
  </div>
  <script>
    (function() {
      const form = document.getElementById('registerForm');
      const termsModalEl = document.getElementById('termsModal');
      const agreeCheckbox = document.getElementById('agreeTerms');
      const agreeBtn = document.getElementById('agreeContinueBtn');
      const termsAcceptedInput = document.getElementById('termsAccepted');
      if (!form || !termsModalEl || !agreeCheckbox || !agreeBtn || !termsAcceptedInput) return;

      const termsModal = new bootstrap.Modal(termsModalEl, { backdrop: 'static', keyboard: false });
      let hasAgreed = false;

      form.addEventListener('submit', (e) => {
        if (hasAgreed) return;
        e.preventDefault();
        agreeCheckbox.checked = false;
        agreeBtn.disabled = true;
        termsModal.show();
      });

      agreeCheckbox.addEventListener('change', () => {
        agreeBtn.disabled = !agreeCheckbox.checked;
      });

      agreeBtn.addEventListener('click', () => {
        hasAgreed = true;
        termsAcceptedInput.value = 'yes';
        termsModal.hide();
        form.submit();
      });
    })();
  </script>
</body>
</html>

